        "custom_liquid_main_info": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<script>\n(function() {\n  // Wait for DOM to be ready\n  function initQuantityPriceUpdater() {\n    const quantitySelector = document.querySelector('[data-quantity-selector]');\n    const priceDisplay = document.querySelector('[data-price]');\n    \n    if (!quantitySelector || !priceDisplay) {\n      // Retry if elements not found\n      setTimeout(initQuantityPriceUpdater, 100);\n      return;\n    }\n    \n    // Get the base price from the price display\n    function getBasePrice() {\n      const priceText = priceDisplay.textContent;\n      const priceMatch = priceText.match(/\\$([\\d,]+\\.?\\d*)/i);\n      return priceMatch ? parseFloat(priceMatch[1].replace(/,/g, '')) : 0;\n    }\n    \n    // Update total price when quantity changes\n    function updateTotalPrice() {\n      const selectedOption = quantitySelector.querySelector('input[type=\"radio\"]:checked');\n      if (selectedOption) {\n        const quantity = parseInt(selectedOption.value) || 1;\n        const basePrice = getBasePrice();\n        const totalPrice = (basePrice * quantity).toFixed(2);\n        \n        // Create or update total price display\n        let totalPriceDisplay = document.querySelector('[data-total-price]');\n        if (!totalPriceDisplay) {\n          totalPriceDisplay = document.createElement('div');\n          totalPriceDisplay.setAttribute('data-total-price', '');\n          totalPriceDisplay.style.cssText = 'margin-top: 10px; font-size: 1.2em; font-weight: bold; color: #c9907a;';\n          priceDisplay.parentNode.insertAfter(totalPriceDisplay, priceDisplay);\n        }\n        totalPriceDisplay.textContent = 'Total: $' + totalPrice;\n      }\n    }\n    \n    // Listen for quantity changes\n    quantitySelector.addEventListener('change', updateTotalPrice);\n    \n    // Initial update\n    updateTotalPrice();\n  }\n  \n  // Start initialization when DOM is ready\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initQuantityPriceUpdater);\n  } else {\n    initQuantityPriceUpdater();\n  }\n})();\n</script>"
          }
        }
      },
